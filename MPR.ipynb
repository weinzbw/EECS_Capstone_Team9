from ../peripherals/ultrasonic.ipynb import measure_distance # This import may be formatted wrong
from pynq.overlays.base import BaseOverlay
base = BaseOverlay("base.bit")
pAudio = base.audio

class MPR:
  def __init__(self, difficulty=0):
    self.difficulty = difficulty
    self.running = False

  def count_walls(self):
    count = 0
    for i in range(4):
      movement.turn_right()
      if measure_distance < 20:
        count += 1
    return count
    
  def find_hiding_spot(self, time=120):
    # two minutes for hiding to not waste time.

    while time is not 0:
      distance = measure_distance()

      if distance < 20: # The robot is in front of a wall
        walls = MPR.count_walls() # Returns number of walls around MPR
        if walls >= self.difficulty # difficulty represents # of walls that must be around the MPR
          self.running = True
          MPR.hide() # Shutdown command tbd
        else:
          # Functions to be created in the movement file
          MPR.backup()
          MPR.turn_right()
      else:
        MPR.move() # Robot moves around randomly to find a spot

      self.difficulty = self.difficulty - 1
      MPR.hiding(time/2) # If the MPR cannot find a spot, the difficulty is decreased

  def hide(self):
    # ADD AUDIO TO SAY FIND ME!
    while self.running:
      pAudio.record(1)
      pAudio.save("sound")
      if "marco" in speech_recognition(sound):
        pAudio.load("polo")
        pAudio.play()

      if base.buttons[0].read or base.buttons[1].read() or base.buttons[2].read() or base.buttons[3].read():
        self.running = False

    MPR.end()

  def end(self):
    pAudio.load("scream.wav")
    pAudio.play()
    
