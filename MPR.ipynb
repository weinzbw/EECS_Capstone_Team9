import random
import time as t

# Load and execute ultrasonic sensor from notebook
with open("../peripherals/Ultrasonic code") as f:
    nb = nbformat.read(f, as_version=4)

for cell in nb.cells:
    if cell.cell_type == 'code':
        exec(cell.source)

from pynq.overlays.base import BaseOverlay
base = BaseOverlay("base.bit")
pAudio = base.audio

class MPR:
  def __init__(self, difficulty=0):
    self.difficulty = difficulty
    self.running = False

  def count_walls(self):
    count = 0
    for i in range(4):
      turnRight(2.7)
      if measure_distance < 3:
        count += 1
    return count
    
  def find_hiding_spot(self, time=120):
    # two minutes for hiding to not waste time.

    start_time = t.time()

    while 1:
      distance = measure_distance()

      if distance < 3: # The robot is in front of a wall
        stop()
        walls = MPR.count_walls() # Returns number of walls around MPR
        if walls >= self.difficulty # difficulty represents # of walls that must be around the MPR
          self.running = True
          self.hide() # Shutdown command tbd
        else:
          moveBackward(1)
          random_float = random.uniform(1.0, 5.0) # Generates a random float between 1.0 and 5.0 (inclusive)
          turnRight(random_float)
      else:
        move_inf() # Robot moves forward until it finds a wall

      if t.time - start_time >= time:
        break

    self.difficulty = self.difficulty - 1
    MPR.hiding(time/2) # If the MPR cannot find a spot, the difficulty is decreased

  def hide(self):
    # ADD AUDIO TO SAY FIND ME!
    while self.running:
      pAudio.record(1)
      pAudio.save("sound")
      if "marco" in speech_recognition(sound):
        pAudio.load("polo")
        pAudio.play()

      if base.buttons[0].read or base.buttons[1].read() or base.buttons[2].read() or base.buttons[3].read():
        self.running = False

    MPR.end()

  def end(self):
    pAudio.load("scream")
    pAudio.play()
    
