DIRECTIONS = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # forward, right, left, back

class DynamicMazeSolver:
    def __init__(self, start, goal_angle, goal_distance):
        self.robot_position = np.array(start, dtype=float) # Start position
        self.mic_A = np.array([0, 0])  # Define positions for microphones A and B
        self.mic_B = np.array([1, 0])
        self.goal_position = None  # Will be set dynamically
        self.known_walls = set() # Set to store known walls
        self.path = [] # Path to goal
        self.explored = set()
        self.orientation = 0

    def calculate_goal_position(self, angle_degrees, distance):
        """Converts polar coordinates (angle in degrees, distance) into Cartesian coordinates."""
        angle_radians = np.radians(angle_degrees)  # <-- convert degrees to radians
        goal_x = self.robot_position[0] + distance * np.cos(angle_radians)
        goal_y = self.robot_position[1] + distance * np.sin(angle_radians)
        return np.array([goal_x, goal_y])
    
    def get_goal_from_loc_calc(self):
        """Retrieve goal position data from location calculation method."""
        # Get the angle and distance data using microphones A and B
        audio_samples = get_audio_data()  # Placeholder for actual audio data
        dB_A = calculate_decibel(audio_samples[:, 0])
        dB_B = calculate_decibel(audio_samples[:, 1])
        results = estimate_direction_and_time(self.mic_A, self.mic_B, dB_A, dB_B)

        if results:
            # Assuming we are using the first result as the valid one
            result = results[0]
            goal_angle = result["angle_deg"]
            goal_distance = np.linalg.norm(result["source_position"] - np.array(self.mic_A))
            self.goal_position = self.calculate_goal_position(goal_angle, goal_distance)
            print(f"Goal Position: {self.goal_position}")
        else:
            print("Error: No valid goal from loc_calc.")
            return None

    def heuristic(self, position):
        """Manhattan distance from position to goal."""
        return abs(position[0] - self.goal_position[0]) + abs(position[1] - self.goal_position[1])
    
    def update_walls(self):
        """Uses Ultrasonic readings to detect nearby walls and update known_walls set."""
        # Forward
        #distance = measure_distance()
        distance = 1
        if distance < 0.3:
            dx, dy = self.get_forward_vector()
            forward_pos = tuple(np.round(self.robot_position + np.array([dx, dy])).astype(int))
            self.known_walls.add(forward_pos)
    
    
    def bfs_recalculate_path(self):
        """Recalculates the best path using BFS based on discovered walls."""
        start = tuple(np.round(self.robot_position).astype(int))
        goal = tuple(np.round(self.goal_position).astype(int))
        queue = deque([(start, [])])
        visited = set()

        while queue:
            current_pos, path = queue.popleft()
            if current_pos == tuple(self.goal_position):
                return path  # Return shortest path found

            if current_pos in visited:
                continue
            visited.add(current_pos)

            for dr, dc in DIRECTIONS:
                next_pos = (current_pos[0] + dr, current_pos[1] + dc)
                if next_pos not in self.known_walls and next_pos not in visited:
                    queue.append((next_pos, path + [next_pos]))

        return []  # No path found
    def get_forward_vector(self):
        """Return (dx, dy) based on current orientation."""
        angle = self.orientation % 360
        if angle == 0:
            return (0, 1)    # facing up (+y)
        elif angle == 90:
            return (1, 0)    # facing right (+x)
        elif angle == 180:
            return (0, -1)   # facing down (-y)
        elif angle == 270:
            return (-1, 0)   # facing left (-x)
        else:
            raise ValueError(f"Unexpected orientation angle: {self.orientation}")


    def move_robot(self):
        """Moves the robot optimistically toward the goal."""
        while np.linalg.norm(self.robot_position - self.goal_position) > 0.5:
            print("\nCurrent Robot Position:", np.round(self.robot_position, 2))
            print("Goal Position:", np.round(self.goal_position, 2))
            self.update_walls()
            time.sleep(0.5)

            if not self.path:
                print("Recalculating path...")
                self.path = self.bfs_recalculate_path()
                if not self.path:
                    print("No available path to goal.")
                    stopMotors()
                    return

            next_step = self.path.pop(0)
            desired_direction = (next_step[0] - int(round(self.robot_position[0])), next_step[1] - int(round(self.robot_position[1])))

            forward = self.get_forward_vector()
            
            if desired_direction == forward:
                moveForward(1)
            elif desired_direction == (forward[1], -forward[0]):  # Right turn
                turnRight(1.6)
                self.orientation = (self.orientation + 90) % 360
                moveForward(1)
            elif desired_direction == (-forward[1], forward[0]):  # Left turn
                turnLeft(1.6)
                self.orientation = (self.orientation - 90) % 360
                moveForward(1)
            elif desired_direction == (-forward[0], -forward[1]):  # Backward
                moveBackward(1)
            else:
                print("Invalid direction, stopping motors.")
                stopMotors()
                return
        
            self.robot_position = np.array(next_step, dtype=float) # Update robot position
            self.explored.add(tuple(next_step)) # Add to explored set
            stopMotors()
            time.sleep(0.5)

        print("Robot reached the goal!")
        stopMotors()
        

# Initialize robot's start position and goal in polar coordinates
start_position = (0, 0)

solver = DynamicMazeSolver(start_position, mic_A, mic_B)

# Get the goal position from the audio data
solver.get_goal_from_loc_calc()

solver.move_robot()
