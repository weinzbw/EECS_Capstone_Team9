import time
import numpy as np
from pynq.overlays.base import BaseOverlay
from scipy.io import wavfile
import os

# Initialize PYNQ base overlay
base = BaseOverlay("base.bit")
pAudio = base.audio

# ---------- Helper Functions ----------

def distance_ratio_from_db(dB_A, dB_B):
    """Convert dB difference to distance ratio (rB/rA)."""
    return 10 ** ((dB_A - dB_B) / 20)

def find_circle_intersections(c1, r1, c2, r2):
    """Find intersection points of two circles centered at c1, c2 with radii r1, r2."""
    d = np.linalg.norm(c2 - c1)
    if d > r1 + r2 or d < abs(r1 - r2) or d == 0:
        return []
    a = (r1 ** 2 - r2 ** 2 + d ** 2) / (2 * d)
    h = np.sqrt(max(0, r1 ** 2 - a ** 2))
    p2 = c1 + a * (c2 - c1) / d
    offset = h * np.array([-(c2[1] - c1[1]) / d, (c2[0] - c1[0]) / d])
    return [p2 + offset, p2 - offset]

def travel_time(source, mic, speed=5):
    """Calculate time for MPR to travel to source"""
    distance = np.linalg.norm(np.array(source) - np.array(mic))
    return distance / speed

def estimate_direction_and_time(mic_A, mic_B, dB_A, dB_B, speed=5):
    """Estimate sound source positions, direction, and travel times with auto-scaled radii."""
    ratio = distance_ratio_from_db(dB_A, dB_B)
    mic_distance = np.linalg.norm(mic_B - mic_A)

    # 🔁 Auto-scale rA and rB to ensure circles intersect
    rA = mic_distance / (1 + ratio)
    rB = rA * ratio

    intersections = find_circle_intersections(np.array(mic_A), rA, np.array(mic_B), rB)

    if not intersections:
        print("❌ No intersection found. Circles do not intersect.")
        return []

    midpoint = (np.array(mic_A) + np.array(mic_B)) / 2
    results = []

    for pt in intersections:
        vec = pt - midpoint
        angle_deg = np.degrees(np.arctan2(vec[1], vec[0]))
        time_to_A = travel_time(pt, mic_A, speed)
        time_to_B = travel_time(pt, mic_B, speed)
        results.append({
            "source_position": pt,
            "angle_deg": angle_deg,
            "time_to_A": time_to_A,
            "time_to_B": time_to_B,
            "time_diff_AB": time_to_A - time_to_B
        })

    return results

# ---------- Decibel Calculation Function ----------
def calculate_decibel(audio_data):
    """Calculate decibel level from audio data."""
    # Normalize the data to [-1, 1] range if it's in integer format
    if audio_data.dtype == np.int16:
        audio_data = audio_data / 32768.0
    elif audio_data.dtype == np.int32:
        audio_data = audio_data / 2147483648.0
    elif audio_data.dtype == np.uint8:
        audio_data = (audio_data - 128) / 128.0

    # If stereo, just use one channel
    if len(audio_data.shape) > 1:
        audio_data = audio_data[:, 0]

    # Calculate RMS (root mean square)
    rms = np.sqrt(np.mean(audio_data**2))

    # Convert to decibels
    db = 20 * np.log10(rms) if rms > 0 else -np.inf

    return db

# ---------- Main Setup ----------
# Microphone positions (in meters)
mic_A = np.array([0, 0])  # Position of the first microphone
mic_B = np.array([1, 0])  # Position of the second microphone

# Initialize Audio input using PYNQ Audio module (use provided audio file)
pAudio.load("/home/xilinx/pynq/lib/tests/pynq_welcome.pdm")
pAudio.play()

# Record audio from both microphones
print("Recording 3 seconds of audio for Mic A...")
pAudio.record(3)
pAudio.save("Recording_A.pdm")

print("Recording 3 seconds of audio for Mic B...")
pAudio.record(3)
pAudio.save("Recording_B.pdm")

# Load the recorded audio data (PDM files are typically raw, so we convert them to an appropriate format)
# Convert PDM to PCM (WAV format) to process the audio data
def pdm_to_pcm(pdm_file, output_wav):
    """Convert PDM audio file to PCM (WAV)."""
    # Load PDM file (assuming it is 8-bit signed integer PDM data)
    # Convert to PCM format: this is a simplified assumption for the example.
    sampling_rate = 44100  # Use 44.1kHz as the sample rate (you can adjust as needed)

    # Open and read the PDM file
    with open(pdm_file, "rb") as f:
        raw_pdm_data = np.frombuffer(f.read(), dtype=np.uint8)

    # Simple mock conversion (this should be done with proper PDM to PCM algorithm)
    pcm_data = (raw_pdm_data - 128) / 128.0  # Normalize to range [-1, 1]

    # Save to WAV format (for simplicity, we'll just save as a mono WAV file)
    wavfile.write(output_wav, sampling_rate, pcm_data.astype(np.float32))

# Convert the recorded PDM files to WAV files
pdm_to_pcm("Recording_A.pdm", "Recording_A.wav")
pdm_to_pcm("Recording_B.pdm", "Recording_B.wav")

# Load the PCM data (WAV format) for analysis
_, audio_data_A = wavfile.read("Recording_A.wav")  # Load mic A data
_, audio_data_B = wavfile.read("Recording_B.wav")  # Load mic B data

# Calculate decibels for both microphones
dB_A = calculate_decibel(audio_data_A)  # Decibels from mic_A
dB_B = calculate_decibel(audio_data_B)  # Decibels from mic_B

# Print decibel levels
print(f"Decibel level for Mic A: {dB_A:.2f} dB")
print(f"Decibel level for Mic B: {dB_B:.2f} dB")

# Get results from the estimated sound source position and angle
results = estimate_direction_and_time(mic_A, mic_B, dB_A, dB_B)

# ---------- Print Results ----------
print("\n📡 Estimated Sound Source Information:\n")

if results:
    for i, res in enumerate(results):
        source_pos = res["source_position"]
        angle = res["angle_deg"]
        time_to_A = res["time_to_A"]
        time_to_B = res["time_to_B"]
        time_diff_AB = res["time_diff_AB"]

        print(f"--- Possible Sound Source {i + 1} ---")
        print(f"📍 Position:         [{source_pos[0]:.4f}, {source_pos[1]:.4f}]")
        print(f"🧭 Direction Angle:  {angle:.2f}° from midpoint")
        print(f"⏱️  Time from Mic A:    {time_to_A:.6f} s")
        print(f"⏱️  Time from Mic B:    {time_to_B:.6f} s")
        print(f"🔁 Time A - B:        {time_diff_AB:.6f} s")
        print("-" * 40)
else:
    print("No valid sound source locations found due to geometry or input values.")
