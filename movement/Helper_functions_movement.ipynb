from pynq.overlays.base import BaseOverlay
from pynq.lib.pmod import Pmod_IO
import time

# Load the base overlay to access GPIO pins
base = BaseOverlay("base.bit")

# Define the Pmod_IO pins for motor control (connected to L298N)
# Using both halves of PMODA (IO0–IO7) to control two motors
motor1_in1 = Pmod_IO(base.PMODA, 4, "out")  # IN1 pin (Motor 1) -> IO4
motor1_in2 = Pmod_IO(base.PMODA, 5, "out")  # IN2 pin (Motor 1) -> IO5
motor2_in1 = Pmod_IO(base.PMODA, 6, "out")  # IN3 pin (Motor 2) -> IO6
motor2_in2 = Pmod_IO(base.PMODA, 7, "out")  # IN4 pin (Motor 2) -> IO7

motor1_in3 = Pmod_IO(base.PMODA, 0, "out")  # IN1 pin (Motor 1 mirror) -> IO0
motor1_in4 = Pmod_IO(base.PMODA, 1, "out")  # IN2 pin (Motor 1 mirror) -> IO1
motor2_in3 = Pmod_IO(base.PMODA, 2, "out")  # IN3 pin (Motor 2 mirror) -> IO2
motor2_in4 = Pmod_IO(base.PMODA, 3, "out")  # IN4 pin (Motor 2 mirror) -> IO3

# Function to stop the motors
def stopMotors():
    print("Motors stopped")
    motor1_in1.write(0)
    motor1_in2.write(0)
    motor2_in1.write(0)
    motor2_in2.write(0)
    motor1_in3.write(0)
    motor1_in4.write(0)
    motor2_in3.write(0)
    motor2_in4.write(0)

# Function to move forward
def moveForward(duration):
    print("Moving forward")
    motor1_in1.write(1)
    motor1_in2.write(0)
    motor2_in1.write(1)
    motor2_in2.write(0)
    motor1_in3.write(1)
    motor1_in4.write(0)
    motor2_in3.write(1)
    motor2_in4.write(0)
    time.sleep(duration)
    stopMotors()

# Function to move backward
def moveBackward(duration):
    print("Moving backward")
    motor1_in1.write(0)
    motor1_in2.write(1)
    motor2_in1.write(0)
    motor2_in2.write(1)
    motor1_in3.write(0)
    motor1_in4.write(1)
    motor2_in3.write(0)
    motor2_in4.write(1)
    time.sleep(duration)
    stopMotors()

# Function to turn left
def turnLeft(duration):
    print("Turning left")
    motor1_in1.write(1)
    motor1_in2.write(0)
    motor2_in1.write(0)
    motor2_in2.write(1)
    motor1_in3.write(1)
    motor1_in4.write(0)
    motor2_in3.write(0)
    motor2_in4.write(1)
    time.sleep(duration)
    stopMotors()

# Function to turn right
def turnRight(duration):
    print("Turning right")
    motor1_in1.write(0)
    motor1_in2.write(1)
    motor2_in1.write(1)
    motor2_in2.write(0)
    motor1_in3.write(0)
    motor1_in4.write(1)
    motor2_in3.write(1)
    motor2_in4.write(0)
    time.sleep(duration)
    stopMotors()

