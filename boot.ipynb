from time import sleep
from pynq.overlays.base import BaseOverlay
from pynq import GPIO

# Load and execute seeking algorithm from notebook
with open("/algorithms/maze_solver_dynamic.ipynb") as f:
    nb = nbformat.read(f, as_version=4)

for cell in nb.cells:
    if cell.cell_type == 'code':
        exec(cell.source)

# Load and execute MPR class from notebook
with open("MPR.ipynb") as f:
    nb = nbformat.read(f, as_version=4)

for cell in nb.cells:
    if cell.cell_type == 'code':
        exec(cell.source)

base = BaseOverlay("base.bit")

gpio = GPIO.get_gpio_pin(1)

print("Board On")

running = True
hiding_mode = False

difficulty = ''

while running:
    if base.buttons[0].read() == 1:
        running = False
        
    if base.buttons[1].read() == 1:
        print('Seeking Mode')
        while base.buttons[1].read() == 1:
            pass
        # Waits for one minute then calls the seeking algorithm
        sleep(60)
        solver = DynamicMazeSolver(start_position, goal_angle, goal_distance)
        solver.move_robot()
        
    if base.buttons[2].read() == 1:
        print('Hiding Mode')
        hiding_mode = True
        while base.buttons[2].read() == 1:
            pass
        
    while hiding_mode:
        if base.buttons[0].read() == 1:
            running = False
            hiding_mode = False
            
        if base.buttons[1].read() == 1:
            print('Easy')
            difficulty = 1
            bot = MPR(difficulty)
            bot.find_hiding_spot()
            while base.buttons[1].read() == 1:
                pass

        if base.buttons[2].read() == 1:
            print('Medium')
            difficulty = 2
            bot = MPR(difficulty)
            bot.find_hiding_spot()
            while base.buttons[2].read() == 1:
                pass

        if base.buttons[3].read() == 1:
            print('Hard')
            difficulty = 3
            bot = MPR(difficulty)
            bot.find_hiding_spot()
            while base.buttons[3].read() == 1:
                pass

print('Board Off')
